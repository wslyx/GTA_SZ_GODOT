[layer_names]

3d_render/layer_1="Terrain"
3d_render/layer_2="Buildings"
3d_render/layer_3="Roads"
3d_render/layer_4="Vehicles"
3d_render/layer_5="Pedestrians"
3d_render/layer_6="Water"
3d_render/layer_7="Sky"
3d_render/layer_8="Props"
3d_physics/layer_1="World"
3d_physics/layer_2="Vehicle"
3d_physics/layer_3="Pedestrian"
3d_physics/layer_4="Prop"
3d_physics/layer_5="Projectile"

[physics]

3d/default_gravity=0.0

[rendering]

renderer/rendering_method.mobile="forward_plus"
global_illumination/gi/use_half_resolution=true
textures/default_filters/anisotropic_filtering_level=3
# 4×MSAA（msaa_3d=2）在 1080p + Forward+ 下要按 4 倍采样率跑满屏色深缓冲，
# 是本作最大的单项 GPU 开销。改用 FXAA（screen_space_aa=1）做后处理抗锯齿，
# 画质差别不大但帧时间明显下降。
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.39, 0.54, 0.63, 1)
anti_aliasing/quality/screen_space_aa=1
