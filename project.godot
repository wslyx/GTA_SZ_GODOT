; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="深城纪 Shenchengji"
config/description="深圳城市探索原型 · Godot 4.7 重制版（对 Babylon.js 原版 GTA_SZ 的一比一移植）"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CoordinateUtil="*res://scripts/utils/coordinate_util.gd"
GameContent="*res://scripts/core/game_content.gd"
GameState="*res://scripts/core/game_state.gd"
SaveSystem="*res://scripts/core/save_system.gd"
GraphicsQuality="*res://scripts/core/graphics_quality.gd"
CityData="*res://scripts/core/city_data.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

