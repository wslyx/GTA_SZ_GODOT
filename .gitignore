# ============================================================
# 深城纪 Godot 4.7 重制版 · .gitignore
#
# 约定：
#   - data/ 下的 GLB / 贴图 / HDR 是项目资产，纳入版本管理，由 Git LFS 托管
#     （LFS 规则写在 .gitattributes，不在本文件里）
#   - data/ 可由 ../GTA_SZ/public 通过 tools/convert_glb.mjs 重新生成，
#     但源仓库与本项目不同库，故此处仍选择入库以便克隆即跑
# ============================================================

# ------------------------------------------------------------
# Godot 4.x —— 引擎生成物
# ------------------------------------------------------------
# 导入缓存与编辑器状态（本机生成，约 900 MB，README 已注明不应提交）
.godot/
/android/

# Godot 特定临时 / 生成文件
*.translation          # 由 CSV 自动生成的翻译资源
*.tmp
*.log
export_presets.cfg     # 含本机导出路径与签名密钥，不应入库

# C# / Mono（ALS 角色迁移接入后的 .NET 8 工程）
.mono/
mono_crash.*.json
data_*/
bin/
obj/
*.user

# 构建与导出产物
*.pck
*.zip
*.7z
*.exe
*.dll
*.apk
*.aab
*.dSYM/
build/
export/
dist/
/android/build/

# ------------------------------------------------------------
# 工具链 —— tools/ 下的转换脚本依赖 Node / Python
# ------------------------------------------------------------
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.venv/
venv/

# tools/ 运行产物：截图探针输出（tools/_shot.gd 写入，磁盘保留不入库；
# .gdignore 仍入库，保证 Godot 不导入该目录）
tools/shots/*.png
tools/shots/*.jpg
# 临时备份（shot_plan.json 的本地改稿）
tools/shot_plan.backup.json
*.egg-info/

# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# ------------------------------------------------------------
# 编辑器 / IDE
# ------------------------------------------------------------
.vscode/
.idea/
.vs/
*.sublime-workspace
*.swp
*.swo
*~
*.stackdump

# 调试转储文件：体积巨大（GB 级），禁止入库
# 如需历史留存，请放对象存储或 Git LFS 独立仓库
tools/dumps/
*.dmp
